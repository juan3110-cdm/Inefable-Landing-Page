# Resend API key — get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email address that receives all leads
CONTACT_EMAIL=tu@email.com

# Anthropic API key — required by api/chat.ts for the chat widget
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: tracking & spam protection (site launches fine without these) ---

# GA4 Measurement ID — https://analytics.google.com. Client-side, gated
# behind cookie consent. Leave unset to skip GA4 entirely.
VITE_GA4_ID=G-XXXXXXXXXX

# Meta Pixel ID — https://business.facebook.com/events_manager. Client-side,
# gated behind cookie consent. Leave unset to skip Meta Pixel entirely.
VITE_META_PIXEL_ID=000000000000000

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Both must be set together, or neither: with no site key the widget doesn't
# render and the server-side check is skipped (falls back to honeypot only).
VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000
